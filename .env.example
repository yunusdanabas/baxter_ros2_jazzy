# Copy to .env only if you need local overrides.
BAXTER_PROFILE=sim
# No ROS_DOMAIN_ID / GZ_PARTITION: the documented workflow runs one simulation
# at a time, and forcing a domain here silently split the bridge from the shim.
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Hardware bridge placeholders. Do not use for sim.
# For a real session: export BAXTER_HOST=<robot-serial>.local then
# source scripts/baxter_env.sh (no lab serial/IP is hardcoded in scripts).
BAXTER_ROBOT_HOSTNAME=
BAXTER_ROBOT_IP=
BAXTER_BRIDGE_HOST_IP=
