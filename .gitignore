build/
install/
log/
.env
.vscode/
__pycache__/
*.py[cod]
*.egg-info/
src/baxter_common_ros2/

# Robot session recordings (bags + inventory snapshots) are tracked: they are
# the only evidence behind the tracking-error and path-tolerance numbers the
# docs quote, and the robot is not always reachable to re-record them.

# Host-local Docker disk inventory (paths, free %, image IDs) — never publish
docker/local_image_inventory.md

# Scratch space for local tooling; nothing here belongs in a release
tmp/

# Manual: sources are tracked, build artifacts are not. The PDF is a few hundred
# KB that would be rewritten on every text edit.
docs/manual/*.pdf
docs/manual/*.aux
docs/manual/*.log
docs/manual/*.out
docs/manual/*.toc
docs/manual/*.fls
docs/manual/*.fdb_latexmk
docs/manual/*.synctex.gz
docs/manual/chapters/*.aux

# The planning corpus and per-gate logs are tracked. They were local-only while
# the tree was being shaped for publication; keeping them costs a one-time
# ~100 MB and preserves the reasoning behind decisions the code cannot show.
# Caches under them stay out.
.cursor/**/*.log
plan/**/__pycache__/
